{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Arizona RP Launcher",
  "version": "2.0.0-beta",
  "identifier": "com.arizona.launcher",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Arizona RP Launcher",
        "width": 1285,
        "height": 732,
        "minWidth": 1032,
        "minHeight": 583,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "visible": false,
        "devtools": false,
        "center": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection"
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "tooltip": "Arizona RP Launcher"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "halfik24",
    "copyright": "© 2026 halfik24",
    "shortDescription": "Лаунчер Arizona RP",
    "longDescription": "Arizona RP Launcher — удобный лаунчер для серверов Arizona RP. Автоматическая установка и обновление, каталог модов и скриптов, патчи, профили и запуск игры в пару кликов.",
    "icon": [
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../src/wallpapers": "wallpapers"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "Belarusian", "Ukrainian", "English"],
        "displayLanguageSelector": true,
        "sidebarImage": "../src/wizard.bmp"
      }
    }
  }
}
